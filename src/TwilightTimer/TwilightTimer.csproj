<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TwilightTimer</AssemblyName>
    <Product>TwilightTimer</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TwilightTimer</RootNamespace>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RestoreSources></RestoreSources>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!-- Base class libraries from Unity Mono (net35-equivalent) -->
  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(GAME_MANAGED)/mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(GAME_MANAGED)/System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GAME_MANAGED)/System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>$(GAME_MANAGED)/System.Xml.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx & Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_CORE)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BEPINEX_CORE)/BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BEPINEX_CORE)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GAME_MANAGED)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HumanAPI">
      <HintPath>$(GAME_MANAGED)/HumanAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- TwilightCore (hard dependency on the TwilightTimer branch). Reference
       its BUILT DLL: build TwilightCore first (dotnet build -c Release), or
       override the path via -p:TWILIGHTCORE=... -->
  <PropertyGroup>
    <TWILIGHTCORE Condition=" '$(TWILIGHTCORE)' == '' ">$(MSBuildThisFileDirectory)..\..\..\TwilightCore\bin\Release\netstandard2.0\TwilightCore.dll</TWILIGHTCORE>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TwilightCore">
      <HintPath>$(TWILIGHTCORE)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity engine modules (only what TwilightTimer uses) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GAME_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Ship default language files alongside the DLL -->
  <ItemGroup>
    <None Include="lang\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Embed the authoritative English base + example translation so the
       plugin always has working localization even if the lang/ folder is not
       copied next to the DLL. Disk lang/*.txt files override these. -->
  <ItemGroup>
    <EmbeddedResource Include="lang\en.txt">
      <LogicalName>TwilightTimer.lang.en.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="lang\zh-Hans.txt">
      <LogicalName>TwilightTimer.lang.zh-Hans.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
